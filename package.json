{
  "name": "blitz-api-js",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the Blitz API — B2B data, search, and enrichment.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Blitz API <founders@blitz-api.ai>",
  "homepage": "https://blitz-api.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/api-blitz/blitz-api-js.git"
  },
  "bugs": {
    "url": "https://github.com/api-blitz/blitz-api-js/issues"
  },
  "keywords": [
    "blitz",
    "blitz-api",
    "b2b",
    "enrichment",
    "linkedin",
    "sales",
    "gtm",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen:enums": "tsx scripts/gen-enums.ts",
    "gen:enums:check": "tsx scripts/gen-enums.ts --check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.0.0",
    "msw": "^2.14.6",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
